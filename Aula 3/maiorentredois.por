programa {
  funcao inicio() {
    real n1, n2

    escreva("Digite o primeiro número: ")
    leia(n1)

    escreva("Digite o segundo número: ")
    leia(n2)

    se (n1 > n2) {
      escreva("Primeiro número maior que o segundo!")
    } senao {
      escreva("Segundo número maior que o primeiro!")
    }

  }
}
